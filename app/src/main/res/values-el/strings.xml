    <!-- Update 2 -->
    <string name="apps_title">Κατανάλωση ανά εφαρμογή</string>
    <string name="apps_now">Ρεύμα μπαταρίας αυτή τη στιγμή</string>
    <string name="apps_explain">Η κατανάλωση αποδίδεται στην εφαρμογή που ήταν στην οθόνη ανάμεσα στις μετρήσεις. Το Android δεν δίνει στις κανονικές εφαρμογές ακριβή ενέργεια ανά εφαρμογή, οπότε πρόκειται για εκτιμήσεις· η δραστηριότητα στο παρασκήνιο μετράει στην ορατή εφαρμογή ή στο «Σβηστή οθόνη».</string>
    <string name="apps_access_title">Χρειάζεται πρόσβαση χρήσης</string>
    <string name="apps_access_body">Για να ξέρει ποια εφαρμογή είναι στην οθόνη, επιτρέψτε την «Πρόσβαση χρήσης» για το Battery Master AI στην επόμενη οθόνη. Τίποτα δεν φεύγει από το κινητό σας.</string>
