    <string name="apps_title">App power usage</string>
    <string name="apps_now">Battery current right now</string>
    <string name="apps_explain">Battery use is attributed to the app that was on screen between measurements. Android doesn\'t give regular apps exact per-app energy, so these are estimates; background activity counts toward the visible app or \"Screen off\".</string>
    <string name="apps_access_title">Usage access needed</string>
    <string name="apps_access_body">To know which app is on screen, allow \"Usage access\" for Battery Master AI in the next screen. Nothing leaves your phone.</string>
    <string name="apps_grant">Open Usage access</string>
    <string name="apps_monitoring_hint">Turn on Continuous monitoring in Settings for accurate per-app numbers. Without it, measurements are only taken about every 15 minutes.</string>
